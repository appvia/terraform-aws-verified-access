locals {
  ## Indicates the dashboard is created
  enable_dashboard = var.dashboard != null
  ## Indicates the metric stream is created
  enable_metric_stream = var.metric_stream != null
  ## The name of the dashboard
  dashboard_name = local.resource_name
  ## Indicates the module creates the role the metric stream writes to Firehose with
  enable_metric_stream_role = local.enable_metric_stream ? var.metric_stream.create_role : false
  ## The role the metric stream writes to Firehose with: the created one, or the supplied one
  metric_stream_role_arn = !local.enable_metric_stream ? null : (
    local.enable_metric_stream_role ? aws_iam_role.metric_stream[0].arn : var.metric_stream.role_arn
  )
  ## The namespaces and metric names streamed: by default every log derived metric and, with topology hub, the whole
  ## AWS/NetworkELB namespace (null metric names); with include, the chosen metrics grouped by namespace
  metric_stream_filters = !local.enable_metric_stream ? {} : (
    var.metric_stream.include == null ? merge(
      { (local.metric_namespace) = null },
      local.enable_load_balancer ? { "AWS/NetworkELB" = null } : {},
      ) : {
      for namespace in distinct([for key in var.metric_stream.include : local.metrics[key].namespace if contains(keys(local.metrics), key)]) :
      namespace => sort(distinct([for key in var.metric_stream.include : local.metrics[key].metric_name if contains(keys(local.metrics), key) && local.metrics[key].namespace == namespace]))
    }
  )

  ## The load balancer metrics per endpoint with targets (dimensions LoadBalancer and TargetGroup), by key suffix. Flow
  ## counts are published per load balancer and zone only, never per target group (observed on a live NLB), so they are
  ## offered per load balancer below
  ## (https://docs.aws.amazon.com/elasticloadbalancing/latest/network/load-balancer-cloudwatch-metrics.html)
  target_group_metrics = {
    healthy-host-count   = { metric_name = "HealthyHostCount", statistic = "Minimum", description = "Healthy targets behind the central load balancer for the endpoint; below 1 the service is unreachable" }
    unhealthy-host-count = { metric_name = "UnHealthyHostCount", statistic = "Maximum", description = "Unhealthy targets behind the central load balancer for the endpoint; above 0 the service is degraded" }
  }

  ## The load balancer wide metrics (dimension LoadBalancer), by key
  load_balancer_metrics = {
    load-balancer-active-flow-count           = { metric_name = "ActiveFlowCount", statistic = "Maximum", description = "Concurrent connections through the central load balancer" }
    load-balancer-new-flow-count              = { metric_name = "NewFlowCount", statistic = "Sum", description = "New connections through the central load balancer" }
    load-balancer-processed-bytes             = { metric_name = "ProcessedBytes", statistic = "Sum", description = "Bytes processed by the central load balancer, both directions" }
    load-balancer-tcp-client-reset-count      = { metric_name = "TCP_Client_Reset_Count", statistic = "Sum", description = "Resets sent by clients (Verified Access) to targets" }
    load-balancer-tcp-target-reset-count      = { metric_name = "TCP_Target_Reset_Count", statistic = "Sum", description = "Resets sent by targets: a service refusing or dropping connections" }
    load-balancer-tcp-elb-reset-count         = { metric_name = "TCP_ELB_Reset_Count", statistic = "Sum", description = "Resets generated by the load balancer, e.g. idle timeout or no healthy target" }
    load-balancer-port-allocation-error-count = { metric_name = "PortAllocationErrorCount", statistic = "Sum", description = "Dropped connections: client address translation ran out of ports for a target" }
  }

  ## Every metric the module makes available, by key: the log derived metrics chosen, the log group metrics and, with
  ## topology hub, the central load balancer metrics. Verified Access publishes no CloudWatch metrics of its own
  metrics = merge(
    {
      for key in local.selected_log_metrics : key => {
        namespace   = local.metric_namespace
        metric_name = local.log_metrics[key].metric_name
        dimensions  = {}
        statistic   = "Sum"
        source      = "log metric filter"
        description = local.log_metrics[key].description
      }
    },
    !local.enable_cloudwatch_logs ? {} : {
      incoming-log-events = {
        namespace   = "AWS/Logs"
        metric_name = "IncomingLogEvents"
        dimensions  = { LogGroupName = local.log_group_name }
        statistic   = "Sum"
        source      = "AWS/Logs"
        description = "Access log events received by the log group; none means logging stopped, or nobody is connecting"
      }
      incoming-bytes = {
        namespace   = "AWS/Logs"
        metric_name = "IncomingBytes"
        dimensions  = { LogGroupName = local.log_group_name }
        statistic   = "Sum"
        source      = "AWS/Logs"
        description = "Bytes of access logs received by the log group, which drives the ingestion cost"
      }
    },
    !local.enable_load_balancer ? {} : {
      for key, metric in local.load_balancer_metrics : key => {
        namespace   = "AWS/NetworkELB"
        metric_name = metric.metric_name
        dimensions  = { LoadBalancer = aws_lb.current[0].arn_suffix }
        statistic   = metric.statistic
        source      = "AWS/NetworkELB"
        description = metric.description
      }
    },
    merge([
      for name, _ in local.load_balancer_endpoints : {
        for suffix, metric in local.target_group_metrics : format("%s/%s", name, suffix) => {
          namespace   = "AWS/NetworkELB"
          metric_name = metric.metric_name
          dimensions  = { LoadBalancer = aws_lb.current[0].arn_suffix, TargetGroup = aws_lb_target_group.current[name].arn_suffix }
          statistic   = metric.statistic
          source      = "AWS/NetworkELB"
          description = format("%s (%s)", metric.description, name)
        }
      }
    ]...),
  )
}

## Provision the CloudWatch dashboard answering is it up, what is failing and who is connecting now: access decisions,
## HTTP errors, healthy targets per endpoint (topology hub) and the who-is-connecting query
resource "aws_cloudwatch_dashboard" "current" {
  count = local.enable_dashboard ? 1 : 0

  dashboard_name = local.dashboard_name

  dashboard_body = jsonencode({
    widgets = concat(
      [
        {
          type   = "metric"
          x      = 0
          y      = 0
          width  = 12
          height = 6
          properties = {
            metrics = [
              [local.metric_namespace, "AccessAllowed", { label = "Allowed" }],
              [local.metric_namespace, "AccessDenied", { label = "Denied" }],
            ]
            period = var.dashboard.period
            region = data.aws_region.current.region
            stat   = "Sum"
            title  = "Access decisions"
            view   = "timeSeries"
          }
        },
        {
          type   = "metric"
          x      = 12
          y      = 0
          width  = 12
          height = 6
          properties = {
            metrics = [
              [local.metric_namespace, "Http504", { label = "HTTP 504" }],
              [local.metric_namespace, "Http5xx", { label = "HTTP 5xx" }],
            ]
            period = var.dashboard.period
            region = data.aws_region.current.region
            stat   = "Sum"
            title  = "HTTP errors"
            view   = "timeSeries"
          }
        },
      ],
      length(local.load_balancer_endpoints) == 0 ? [] : [
        {
          type   = "metric"
          x      = 0
          y      = 6
          width  = 24
          height = 6
          properties = {
            metrics = [
              for name, _ in local.load_balancer_endpoints : [
                "AWS/NetworkELB", "HealthyHostCount",
                "TargetGroup", aws_lb_target_group.current[name].arn_suffix,
                "LoadBalancer", aws_lb.current[0].arn_suffix,
                { label = name },
              ]
            ]
            period = 60
            region = data.aws_region.current.region
            stat   = "Minimum"
            title  = "Healthy targets per endpoint"
            view   = "timeSeries"
          }
        },
      ],
      [
        {
          type   = "log"
          x      = 0
          y      = 12
          width  = 24
          height = 8
          properties = {
            query  = format("SOURCE '%s' | %s", local.log_group_name, trimspace(local.queries["who-is-connecting"]))
            region = data.aws_region.current.region
            title  = "Who is connecting"
            view   = "table"
          }
        },
      ],
    )
  })
}

## Stream the log derived metrics and, with topology hub, the load balancer metrics (or only the chosen metrics) to a
## Firehose delivery stream for an external observability platform. Include filters match namespaces and metric names,
## not dimensions, so AWS/NetworkELB carries every network load balancer in the account and region
resource "aws_cloudwatch_metric_stream" "current" {
  count = local.enable_metric_stream ? 1 : 0

  firehose_arn  = var.metric_stream.firehose_arn
  name          = local.resource_name
  output_format = var.metric_stream.output_format
  role_arn      = local.metric_stream_role_arn
  tags          = local.tags

  dynamic "include_filter" {
    for_each = local.metric_stream_filters

    content {
      metric_names = include_filter.value
      namespace    = include_filter.key
    }
  }

  lifecycle {
    ## V81: the streamed metrics are ones the module makes available (output metrics)
    precondition {
      condition     = var.metric_stream.include == null ? true : length(setsubtract(var.metric_stream.include, keys(local.metrics))) == 0
      error_message = format("The metric_stream.include entries %s are not metrics the module makes available here; choose from: %s.", join(", ", try(setsubtract(var.metric_stream.include, keys(local.metrics)), [])), join(", ", sort(keys(local.metrics))))
    }
  }
}

## Provision the role the metric stream writes to Firehose with, when requested: trusted by CloudWatch metric streams
## in this account only
resource "aws_iam_role" "metric_stream" {
  count = local.enable_metric_stream_role ? 1 : 0

  description = format("Writes the Verified Access %s metric stream to Firehose", var.name)
  name        = format("%s-metric-stream", local.resource_name)
  tags        = local.tags

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect    = "Allow"
        Action    = "sts:AssumeRole"
        Principal = { Service = "streams.metrics.cloudwatch.amazonaws.com" }
        Condition = { StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id } }
      }
    ]
  })
}

## Permit the metric stream role to write to the one delivery stream only
resource "aws_iam_role_policy" "metric_stream" {
  count = local.enable_metric_stream_role ? 1 : 0

  name = "put-records"
  role = aws_iam_role.metric_stream[0].id

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Effect   = "Allow"
        Action   = ["firehose:PutRecord", "firehose:PutRecordBatch"]
        Resource = var.metric_stream.firehose_arn
      }
    ]
  })
}
