
output "device_validation_domain" {
  description = "The domain Verified Access uses to validate devices for the endpoint"
  value       = aws_verifiedaccess_endpoint.current.device_validation_domain
}

output "endpoint_domain" {
  description = "The DNS name generated by Verified Access for the endpoint"
  value       = aws_verifiedaccess_endpoint.current.endpoint_domain
}

output "id" {
  description = "The id of the Verified Access endpoint"
  value       = aws_verifiedaccess_endpoint.current.id
}

output "security_group_id" {
  description = "The id of the security group the module created for the endpoint network interfaces, null with create_security_group false"
  value       = var.create_security_group ? aws_security_group.current[0].id : null
}
