output "alarm_topic_arn" {
  description = "The SNS topic notified by the alarms"
  value       = module.verified_access.alarm_topic_arn
}

output "dashboard_name" {
  description = "The name of the CloudWatch dashboard"
  value       = module.verified_access.dashboard_name
}

output "endpoint_domains" {
  description = "The DNS names generated by Verified Access for each endpoint"
  value       = module.verified_access.endpoint_domains
}

output "instance_id" {
  description = "The id of the Verified Access instance"
  value       = module.verified_access.instance_id
}

output "load_balancer_dns_name" {
  description = "The DNS name of the central load balancer in the hub"
  value       = module.verified_access.load_balancer_dns_name
}

output "rendered_policies" {
  description = "The Cedar policies rendered by the module"
  value       = module.verified_access.rendered_policies
}

output "target_private_ip" {
  description = "The private IP of the target in the spoke, reachable over SSH through the Connectivity Client"
  value       = aws_instance.target.private_ip
}
